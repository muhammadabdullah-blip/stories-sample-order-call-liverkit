# ── LiveKit ──────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Twilio SIP ────────────────────────────────────────────────────────────────
SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxxxx          # from: lk sip outbound create
SIP_FROM_NUMBER=+12125550100                      # your Twilio number (caller ID)

# ── AI services ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CARTESIA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...                   # use service_role key (not anon)

# ── Backend self-reference (agent uses this to call webhooks) ─────────────────
BACKEND_URL=http://localhost:8000                  # change to your public URL in prod

# ── Optional: webhook authentication ─────────────────────────────────────────
WEBHOOK_SECRET=your-shared-secret-here            # leave blank to disable

# ── Recording Storage (Supabase) ─────────────────────────────────────────────
SUPABASE_STORAGE_BUCKET=call-recordings

# ── Call behaviour ────────────────────────────────────────────────────────────
DIAL_TIMEOUT_SECS=60
MAX_CALL_DURATION_SECS=1800
